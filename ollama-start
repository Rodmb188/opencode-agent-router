#!/usr/bin/env bash
# Inicializa o servidor Ollama com contexto 12288 (KV cache ~3-4GB)
# Uso: ollama-start
# Para trocar o contexto, altere OLLAMA_CONTEXT_LENGTH abaixo ou exporte antes de chamar.

export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-12288}"

if pgrep -x ollama >/dev/null; then
  printf 'Ollama já está rodando (PID %s). Use "ollama stop all" ou mate o processo antes.\n' "$(pgrep -x ollama | head -1)"
  exit 1
fi

exec ollama serve