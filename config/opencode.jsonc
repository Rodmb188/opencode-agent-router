{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-nothink/nothink-v2",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 4000
    },
    "buffer": 1000
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 1200000
      },
      "models": {
        "qwen3-local": {
          "name": "Qwen 3 14B Abliterate (sem censura)",
          "limit": {
            "context": 8192,
            "output": 1536
          }
        },
        "nothink-v2": {
          "name": "Qwen3.6 27B Abliterate v2 (template corrigido, sem pensar)",
          "limit": {
            "context": 16384,
            "output": 2500
          },
          "options": { "body": { "think": false } }
        },
        "megabrain-v2": {
          "name": "Qwen3.6 27B Abliterate v2 (template corrigido)",
          "limit": {
            "context": 16384,
            "output": 3072
          }
        },
        "nothink": {
          "name": "Qwen3.6 27B Abliterate (sem pensar) [template antigo]",
          "limit": {
            "context": 16384,
            "output": 2500
          },
          "options": { "body": { "think": false } }
        },
        "megabrain": {
          "name": "Qwen3.6 27B Abliterate (mega brain) [template antigo]",
          "limit": {
            "context": 16384,
            "output": 3072
          }
        },
        "vision": {
          "name": "Qwen3-VL 8B (visão)",
          "limit": {
            "context": 16384,
            "output": 1536
          },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": { "body": { "think": false } }
        }
      }
    },
    "ollama-nothink": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local) via proxy corte-na-fonte",
      "options": {
        "baseURL": "http://127.0.0.1:11436/v1",
        "timeout": 1200000
      },
      "models": {
        "qwen3-local": {
          "name": "Qwen 3 14B Abliterate (sem censura)",
          "limit": {
            "context": 8192,
            "output": 1536
          }
        },
        "nothink-v2": {
          "name": "Qwen3.6 27B Abliterate v2 (template corrigido, sem pensar)",
          "limit": {
            "context": 16384,
            "output": 2500
          },
          "options": { "body": { "think": false } }
        },
        "megabrain-v2": {
          "name": "Qwen3.6 27B Abliterate v2 (template corrigido)",
          "limit": {
            "context": 16384,
            "output": 3072
          }
        },
        "nothink": {
          "name": "Qwen3.6 27B Abliterate (sem pensar) [template antigo]",
          "limit": {
            "context": 16384,
            "output": 2500
          },
          "options": { "body": { "think": false } }
        },
        "megabrain": {
          "name": "Qwen3.6 27B Abliterate (mega brain) [template antigo]",
          "limit": {
            "context": 16384,
            "output": 3072
          }
        },
        "vision": {
          "name": "Qwen3-VL 8B (visão)",
          "limit": {
            "context": 16384,
            "output": 1536
          },
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": { "body": { "think": false } }
        }
      }
    }
  }
}